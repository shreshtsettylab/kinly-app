# Copy this file to .env.local (never committed) and fill in your own values.

# Supabase Auth — browser-safe values only.
# Project Settings → API Keys in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or the legacy "anon" key. NEVER the secret or service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: Razorpay Standard Checkout. Razorpay dashboard → Account & Settings → API Keys.
# The key id is public and goes to the browser; leave it empty to hide the checkout.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Server-side only (read by api/create-order.ts and api/verify-payment.ts, never the browser).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Amount in paise (default 9900 = ₹99, minimum 100).
# RAZORPAY_AMOUNT_PAISE=9900

# Optional: Kinly Plus AI features (server-side only — read by api/ai.ts, not the browser).
# Credits are checked in Supabase, so AI also needs the Supabase values above.
# Free option: Cloudflare Workers AI (free daily allowance; the free plan can't be charged).
# Cloudflare dashboard → AI → Workers AI → Use REST API: copy the account id and create a token.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
# Paid option, used only if Cloudflare isn't set: openrouter.ai/keys (give it a credit limit).
# OPENROUTER_API_KEY=

# Kinly Plus subscriptions (server-side only).
# Razorpay → Settings → Webhooks: URL https://www.kinly.in/api/razorpay-webhook, events subscription.*
# RAZORPAY_WEBHOOK_SECRET=
# Supabase → Project Settings → API Keys → Secret key. Never put this in a VITE_ variable.
# SUPABASE_SECRET_KEY=
# Optional: override the Razorpay plan ids in api/_plus.ts
# RAZORPAY_PLAN_MONTH=
# RAZORPAY_PLAN_YEAR=
