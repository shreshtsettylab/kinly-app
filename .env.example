# Copy this file to .env.local (never committed) and fill in your own values.

# Supabase Auth — browser-safe values only.
# Project Settings → API Keys in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or the legacy "anon" key. NEVER the secret or service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: Claude "Deeper answers" (server-side only — read by api/deeper.ts, not the browser).
# ANTHROPIC_API_KEY=
